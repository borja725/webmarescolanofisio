# Cloudflare Pages response headers
# https://developers.cloudflare.com/pages/configuration/headers/
#
# HTML is deliberately NOT listed here. Cloudflare Pages already serves pages
# with "public, max-age=0, must-revalidate", which is exactly what we want: a
# deploy is visible immediately. Pages are also served at extensionless URLs
# (/tratamientos/diatermia), so a /*.html rule would never match them.

# Stylesheets are cache-busted with ?v=N in every <link>.
# Bump that number whenever style.css or responsive.css changes.
/css/*
  Cache-Control: public, max-age=2592000

# Theme fonts never change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Slider assets ship with the purchased template and are not edited.
/revolution/*
  Cache-Control: public, max-age=2592000

# Images are occasionally replaced in place, so keep the window short.
/images/*
  Cache-Control: public, max-age=604800

# JavaScript carries no version query yet, so it has to revalidate.
/js/*
  Cache-Control: public, max-age=0, must-revalidate
